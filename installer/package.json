{
  "name": "password-generator-installer",
  "version": "1.0.0",
  "description": "Password Generator Installer",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "package-win": "electron-packager . --platform=win32 --arch=x64 --out=dist --overwrite",
    "package-mac": "electron-packager . --platform=darwin --arch=x64 --out=dist --overwrite"
  },
  "keywords": ["installer", "password-generator"],
  "author": "Nicholas Arsenault",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-packager": "^17.1.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "fs-extra": "^11.1.1",
    "path": "^0.12.7"
  }
}